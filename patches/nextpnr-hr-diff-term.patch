--- a/himbaechel/uarch/xilinx/pack_io.cc
+++ b/himbaechel/uarch/xilinx/pack_io.cc
@@ -240,6 +240,34 @@
         NPNR_ASSERT(pad_n_net != nullptr);
         std::string tile_p = ctx->get_tile_type(site_p.tile).str(ctx);
         bool is_iob18 = boost::contains(tile_p, "IOB18");
+
+        // Preserve differential termination before primitive decomposition.
+        // An explicit port/XDC property overrides the primitive parameter.
+        IdString diff_term = ctx->id("DIFF_TERM");
+        bool term = boolstr_or_default(xil_iob->params, diff_term, false);
+        bool has_override = false, override_value = false;
+        CellInfo *master_pad = nullptr;
+        for (auto net : {pad_p_net, pad_n_net}) {
+            for (auto user : net->users) {
+                if (user.cell->type != id_PAD)
+                    continue;
+                if (net == pad_p_net)
+                    master_pad = user.cell;
+                if (!user.cell->attrs.count(diff_term))
+                    continue;
+                bool value = boolstr_or_default(user.cell->attrs, diff_term);
+                if (has_override && value != override_value)
+                    log_error("Conflicting DIFF_TERM properties on differential pair.\n");
+                override_value = value;
+                has_override = true;
+            }
+        }
+        if (has_override)
+            term = override_value;
+        NPNR_ASSERT(master_pad != nullptr);
+        master_pad->attrs[diff_term] = Property(term);
+        if (term && is_iob18)
+            log_error("DIFF_TERM support currently covers HR banks only.\n");
 
         if (!is_diff_iobuf && !is_diff_out_iobuf) {
             xil_iob->disconnectPort(id_I);
